# 在服务器上复制成 .env.api。不要把真实密钥发给别人或提交到 Git。
# APP_API_KEY 是你发给客户的服务密钥，与下面两把模型供应商密钥不同。
# 在服务器生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=请替换为生成的随机密钥

SILICONFLOW_API_KEY=请替换为你的硅基流动密钥
DEEPSEEK_API_KEY=请替换为你的DeepSeek密钥

# 填已有索引的位置，支持绝对路径；相对路径以 api.py 所在目录为基准。
RAG_CHROMA_DIR=chroma_db
RAG_BM25_PATH=cache/bm25_index.pkl

# Embedding 必须与现有索引建库时使用的模型一致。
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
